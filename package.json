{
  "name": "paypal-trustshield-ai-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "PayPal TrustShield AI - Next-Gen Fintech Security & Merchant Risk Intelligence",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "start": "npm run dev:backend",
    "dev": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "npm run test --workspace=backend",
    "test:coverage": "npm run test:coverage --workspace=backend"
  },
  "keywords": [
    "paypal",
    "fintech",
    "security",
    "risk-assessment",
    "seller-protection",
    "invoice-scam-shield"
  ],
  "author": "PayPal Hackathon 2026 Team",
  "license": "MIT"
}
