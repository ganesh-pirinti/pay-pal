# ==========================================
# PayPal TrustShield AI — Environment Configuration
# Enterprise Fintech Security & Sandbox Credentials Template
# ==========================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# PayPal Official API Credentials (Server-Side Only)
# Invariant: Never prefix with VITE_ or expose to client browser bundles.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox

# Pluggable AI Intelligence Model Key (Optional)
# When omitted, TrustShield AI seamlessly fails over to its deterministic expert synthesis engine.
GEMINI_API_KEY=

# Underwriting Risk Engine Thresholds (Optional overrides)
# RISK_DISPUTE_ELEVATED_THRESHOLD=0.03
# RISK_DISPUTE_CRITICAL_THRESHOLD=0.08
# RISK_SALES_SURGE_THRESHOLD=1.5
